MOSA_SECRET_KEY=replace-with-a-random-secret
MOSA_PORT=8080
POSTGRES_DB=mosa
POSTGRES_USER=mosa
POSTGRES_PASSWORD=replace-with-another-random-secret
POSTGRES_PORT=5433
# Docker passes PGUSER/PGPASSWORD separately; do not place secrets in the URL.
# For Flask outside Docker, set DATABASE_URL plus PGUSER/PGPASSWORD in its process environment.
# DATABASE_URL=postgresql://127.0.0.1:5433/mosa
